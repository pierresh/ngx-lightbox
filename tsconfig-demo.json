{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./compiled",
    "sourceMap": true,
    "declaration": true,
    "strict": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "noUnusedLocals": true,
    "target": "ES2022",
    "typeRoots": [
      "node_modules/@types"
    ],
    "useDefineForClassFields": false
  },
  "include": [
    "demo/**/*"
  ],
  "angularCompilerOptions": {
    "strictTemplates": false
  }
}
