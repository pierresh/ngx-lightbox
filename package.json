{
  "name": "@pierresh/ngx-lightbox",
  "version": "22.1.0",
  "description": "A port >= Angular 22 for lightbox2",
  "private": true,
  "dependencies": {
    "file-saver": "^2.0.5",
    "ngx-filesaver": "22.0.0",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "rxjs": "^6.5.3 || ^7.4.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.5.0",
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/compiler-cli": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/platform-browser-dynamic": "^22.1.6",
    "@eslint/js": "^10.0.1",
    "@types/file-saver": "^2.0.7",
    "@types/jasmine": "^4.3.0",
    "angular-eslint": "22.5.0",
    "core-js": "^3.25.3",
    "del-cli": "^5.0.0",
    "eslint": "^10.9.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "^4.4.0",
    "karma": "^6.4.1",
    "karma-chrome-launcher": "^3.2.0",
    "karma-jasmine": "^5.1.0",
    "ng-packagr": "22.1.1",
    "rxjs": "^7.5.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0"
  },
  "scripts": {
    "start": "./node_modules/.bin/ng serve",
    "build": "./node_modules/.bin/ng build",
    "build:lib": "del-cli dist/ngx-lightbox && ./node_modules/.bin/ng-packagr -p ng-package.json -c tsconfig.json",
    "test": " ./node_modules/.bin/ng lint && ./node_modules/.bin/ng test",
    "lint": "./node_modules/.bin/ng lint",
    "release": "yarn build:lib && cd dist/ngx-lightbox && npm pkg delete private && npm publish --access public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pierresh/ngx-lightbox.git"
  },
  "keywords": [
    "lightbox2",
    "angularjs",
    "directives",
    "lightbox2",
    "angular",
    "directives"
  ],
  "author": "themyth92",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pierresh/ngx-lightbox/issues"
  },
  "homepage": "https://github.com/pierresh/ngx-lightbox#readme"
}
